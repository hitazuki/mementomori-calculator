{
  "name": "mmt-calculator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install_git_hooks.js",
    "commit:check": "node scripts/validate_commit_message.js --message",
    "test:i18n": "node scripts/test_i18n.js",
    "test:unit": "node --import ./scripts/registerRawLoader.mjs --test",
    "test": "npm run test:i18n && npm run test:unit",
    "predev": "node scripts/gen_all_packs.js",
    "dev": "vite",
    "prebuild": "node scripts/build_character_rating_locales.mjs && npm run test && node scripts/gen_all_packs.js",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-packs": "node scripts/fetch_ultra_sale.js",
    "generate:catalog": "node scripts/generate_character_catalog.mjs",
    "generate:character-thumbnails": "node scripts/generate_character_thumbnails.mjs",
    "sync:master": "node scripts/extract_master_data.js",
    "sync:assets": "node scripts/sync_assets.js && npm run generate:character-thumbnails",
    "sync:raid-icons": "node scripts/sync_raid_skill_icons.mjs",
    "sync:assets:legacy": "node scripts/sync_assets.js --legacy && npm run generate:character-thumbnails"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.4"
  }
}
