":null},{"key":"W","title":"专武技能效果","text":"Lv1: 强化锈蚀掠夺者，「晕厥」效果增加为2回合。\nLv2: 强化战斗用人造人，当D.D.受到攻击且发动攻击的敌人速度低于D.D.，或D.D.受到反弹伤害时，伤害阻绝量额外提升为70%。\nLv3: 强化锈蚀掠夺者，造成的魔法伤害提升为攻击力×470%。"},{"key":"stats","title":"基础资料与最高阶段专武属性","text":"基础速度 3075\nLR 至高女神\n攻击力 +18%\n弱化效果命中 +10%\n魔力 +8%"}],"tags":[{"key":"health","evidence":["P2"]},{"key":"block","evidence":["P2"]},{"key":"resistance","evidence":["P1"]},{"key":"critDown","evidence":["S1"]},{"key":"attack","evidence":["S2"]},{"key":"stun","evidence":["S1","W"]}],"quantitative":{"survival":{"version":"survival-reference-v2","reviewedAt":"2026-09-07","note":"生命100%与独立阻绝50%提供4倍容量；敌速更低或反伤来源时70%阻绝更强。","assumptions":[{"key":"neutral","label":"无克制／无额外增伤","defenseRatio":1,"damageBonus":0,"attackToHp":0.3333333333333333},{"key":"reference","label":"属性克制25%增伤","defenseRatio":1,"damageBonus":0.25,"attackToHp":0.3333333333333333},{"key":"pressure","label":"高增伤压力测试（不作为常规评分基准）","defenseRatio":1,"damageBonus":1,"attackToHp":0.3333333333333333}],"states":[{"label":"普通攻击来源","effects":{"hp":1,"block":0.5},"evidence":["P2"],"comparisons":[{"scenario":"neutral","physical":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4},"magic":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4}},{"scenario":"reference","physical":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4},"magic":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4}},{"scenario":"pressure","physical":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4},"magic":{"factors":{"hp":2,"defense":1,"specificDefense":1,"damage":1,"block":2,"shield":0},"withoutShield":4,"withShield":4}}]},{"label":"低速攻击方或反伤","effects":{"hp":1,"block":0.7},"evidence":["P2","W"],"comparisons":[{"